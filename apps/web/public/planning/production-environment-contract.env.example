# Production environment contract for the locked hosted baseline
#
# Scope keys:
# [V] Vercel web app and route handlers
# [F] Fly.io realtime and worker apps
# [N] Neon Postgres
# [U] Upstash Redis
# [R] Cloudflare R2
# [C] Clerk
# [P] PostHog
# [S] Sentry
#
# This file is a contract template, not a secret store.

# [V] Core app routing
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://adv-human-ai-civ.example.com
APP_RUNTIME_MODE=hosted-candidate

# [N] Neon Postgres
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/adv_human_ai_civ?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/adv_human_ai_civ?sslmode=require

# [C] Clerk shared auth
CLERK_SECRET_KEY=clerk_secret_replace_me
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=clerk_publishable_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# [F] Fly.io runtime targets
FLY_REALTIME_APP_NAME=adv-human-ai-civ-realtime
FLY_WORKER_APP_NAME=adv-human-ai-civ-workers
FLY_PRIMARY_REGION=iad
SESSION_SERVICE_MODE=external-runtime
SESSION_SERVICE_BASE_URL=https://adv-human-ai-civ-realtime.internal.example.com
SESSION_SERVICE_INTERNAL_TOKEN=replace_me_with_shared_server_token
SESSION_SERVICE_COORDINATION_MODE=redis-upstash

# [U] Upstash Redis presence and coordination
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_me

# [R] Cloudflare R2 content and artifact storage
R2_ACCOUNT_ID=replace_me
R2_BUCKET=adv-human-ai-civ-assets
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_PUBLIC_BASE_URL=https://assets.example.com

# [P] PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_replace_me
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_API_KEY=replace_me

# [S] Sentry release monitoring
SENTRY_DSN=https://replace_me@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://replace_me@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=replace_me
SENTRY_ORG=replace_me
SENTRY_PROJECT=adv-human-ai-civ